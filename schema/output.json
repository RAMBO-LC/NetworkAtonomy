{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://networkatonomy.dev/schema/output.json",
  "title": "Network Atonomy Aggregated Results",
  "description": "JSON schema for the aggregated network timing probe results output",
  "type": "object",
  "required": [
    "stages",
    "total",
    "runsRequested",
    "runsSuccessful",
    "runsFailed",
    "url",
    "ip",
    "family",
    "statusCode",
    "warnings",
    "hops"
  ],
  "additionalProperties": false,
  "properties": {
    "stages": {
      "type": "object",
      "required": ["dns", "tcp", "tls", "ttfb", "body"],
      "additionalProperties": false,
      "properties": {
        "dns": { "$ref": "#/$defs/stageStats" },
        "tcp": { "$ref": "#/$defs/stageStats" },
        "tls": { "$ref": "#/$defs/stageStats" },
        "ttfb": { "$ref": "#/$defs/stageStats" },
        "body": { "$ref": "#/$defs/stageStats" }
      }
    },
    "total": { "$ref": "#/$defs/stageStats" },
    "runsRequested": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of probe runs requested"
    },
    "runsSuccessful": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of probe runs that completed successfully"
    },
    "runsFailed": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of probe runs that failed"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "description": "Target URL that was probed"
    },
    "ip": {
      "type": "string",
      "description": "IP address connected to"
    },
    "family": {
      "type": "string",
      "enum": ["IPv4", "IPv6"],
      "description": "Address family of the connected IP"
    },
    "statusCode": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599,
      "description": "HTTP status code of the response"
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Warnings from failed runs (if any)"
    },
    "hops": {
      "type": "array",
      "description": "Per-hop timing results for redirect chain",
      "items": {
        "type": "object",
        "required": ["url", "statusCode", "stages"],
        "additionalProperties": false,
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "statusCode": { "type": "integer", "minimum": 100, "maximum": 599 },
          "stages": {
            "type": "object",
            "required": ["dns", "tcp", "tls", "ttfb", "body"],
            "additionalProperties": false,
            "properties": {
              "dns": { "$ref": "#/$defs/stageStats" },
              "tcp": { "$ref": "#/$defs/stageStats" },
              "tls": { "$ref": "#/$defs/stageStats" },
              "ttfb": { "$ref": "#/$defs/stageStats" },
              "body": { "$ref": "#/$defs/stageStats" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "stageStats": {
      "type": "object",
      "required": ["medianMs", "minMs", "maxMs"],
      "additionalProperties": false,
      "properties": {
        "medianMs": {
          "type": "number",
          "minimum": 0,
          "description": "Median duration in milliseconds"
        },
        "minMs": {
          "type": "number",
          "minimum": 0,
          "description": "Minimum duration in milliseconds"
        },
        "maxMs": {
          "type": "number",
          "minimum": 0,
          "description": "Maximum duration in milliseconds"
        }
      }
    }
  }
}